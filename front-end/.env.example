# Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values
# All variables must start with VITE_ to be accessible in Vite

# API Configuration
VITE_BACKEND_URL=http://localhost:5000
VITE_API_ENDPOINT=/api

# Feature Flags
VITE_ENABLE_SPEECH_RECOGNITION=true
VITE_ENABLE_WEATHER_WIDGET=true

# Music Widget - YouTube Data API (Optional - for full song playback)
# Get your free API key from: https://console.cloud.google.com/apis/credentials
# Free tier: 10,000 units/day (enough for ~3,300 searches)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Analytics
# VITE_ANALYTICS_ID=your_analytics_id
